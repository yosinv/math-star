{
  // Math Star — Cloudflare Worker serving the static site in ./public.
  // The `main` branch is the production source for Cloudflare automatic deployment.
  "name": "math-star",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Accounts are shared with English Star: same Clerk app, same D1 database.
  // Math Star only adds its own table (math_child_state), created by the Worker on first use.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "english-star",
      "database_id": "7449c8c8-1c44-45e4-bcd3-ad2333ae7f60"
    }
  ],
  "vars": {
    // English Star's PRODUCTION Clerk app (same as englishstarkids.com). Public values only.
    "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuZW5nbGlzaHN0YXJraWRzLmNvbSQ",
    // The Worker reads Clerk's public keys from <CLERK_FAPI_URL>/.well-known/jwks.json and requires
    // tokens to be issued by it. No key is pasted here, so a Clerk key rotation needs no change.
    "CLERK_FAPI_URL": "https://clerk.englishstarkids.com",
    "LEGACY_OWNER_FAMILY_ID": "53852750-9496-4d8b-bb8b-f814374709fb"
  },
  // No Clerk secret key is needed on this Worker.
  // Production Clerk only works on englishstarkids.com and its subdomains, so Math Star gets one.
  // math-star.yosinv.workers.dev keeps working (guest mode + a "move to the new address" button).
  "routes": [{ "pattern": "math.englishstarkids.com", "custom_domain": true }],
  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}
